<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Immich Tag Manager</title>
    <HeadOutlet />
    <style>
        body { font-family: sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
        h1 { margin-bottom: 0.5rem; }
        h2 { margin-top: 1.5rem; border-bottom: 1px solid #ccc; padding-bottom: 0.25rem; }
        .proposal { display: flex; align-items: baseline; gap: 0.5rem; margin: 0.4rem 0; }
        .proposal label { cursor: pointer; }
        .arrow { color: #666; }
        .badge-new { background: #e0f0ff; color: #0066cc; border-radius: 3px; padding: 0 4px; font-size: 0.8em; }
        .badge-existing { background: #f0f0f0; color: #444; border-radius: 3px; padding: 0 4px; font-size: 0.8em; }
        .log { background: #f8f8f8; border: 1px solid #ddd; padding: 1rem; border-radius: 4px; font-family: monospace; font-size: 0.9em; max-height: 400px; overflow-y: auto; }
        .log div { margin: 0.2rem 0; }
        .btn { padding: 0.5rem 1.2rem; font-size: 1rem; cursor: pointer; border: none; border-radius: 4px; }
        .btn-primary { background: #0066cc; color: white; }
        .btn-primary:hover { background: #0055aa; }
        .btn-primary:disabled { background: #aaa; cursor: not-allowed; }
        .spinner { display: inline-block; width: 1em; height: 1em; border: 2px solid #ccc; border-top-color: #0066cc; border-radius: 50%; animation: spin 0.7s linear infinite; }
        @@keyframes spin { to { transform: rotate(360deg); } }
        .error { color: #cc0000; background: #fff0f0; padding: 0.5rem 1rem; border-radius: 4px; }
        .select-all { font-size: 0.85em; color: #0066cc; cursor: pointer; margin-left: 0.5rem; }
        .photo-grid { display: flex; flex-direction: column; gap: 1rem; }
        .photo-card { display: flex; gap: 1rem; border: 1px solid #ddd; border-radius: 6px; padding: 0.75rem; background: #fff; }
        .photo-card img { width: 120px; height: 90px; object-fit: cover; border-radius: 4px; flex-shrink: 0; }
        .photo-info { flex: 1; min-width: 0; }
        .tag-chip { display: inline-block; background: #e0f0ff; color: #0066cc; border-radius: 3px; padding: 1px 6px; font-size: 0.8em; margin: 2px; }
        .counter-bar { background: #f8f8f8; border: 1px solid #ddd; border-radius: 4px; padding: 0.5rem 1rem; margin-bottom: 1rem; font-family: monospace; }
        .save-indicator { font-size: 0.85em; color: #555; margin-top: 0.25rem; }
        .badge-queued    { background: #f0f0f0; color: #666; border-radius: 3px; padding: 1px 6px; font-size: .8em; }
        .badge-analyzing { background: #fff3cd; color: #856404; border-radius: 3px; padding: 1px 6px; font-size: .8em; }
        .badge-saving    { background: #d1ecf1; color: #0c5460; border-radius: 3px; padding: 1px 6px; font-size: .8em; }
        .badge-done      { background: #d4edda; color: #155724; border-radius: 3px; padding: 1px 6px; font-size: .8em; }
        .badge-failed    { background: #f8d7da; color: #721c24; border-radius: 3px; padding: 1px 6px; font-size: .8em; }
        .badge-skipped   { background: #f0f0f0; color: #999; border-radius: 3px; padding: 1px 6px; font-size: .8em; }
    </style>
</head>
<body>
    <nav style="margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:1px solid #ccc;">
        <a href="/">Tags beheren</a> |
        <a href="/genereer-tags">Hiërarchie genereren</a> |
        <a href="/analyseer-fotos">Foto-analyse</a> |
        <a href="/instellingen">Instellingen</a>
    </nav>
    <Routes />
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
